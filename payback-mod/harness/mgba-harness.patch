index aa01fdc..d2d1a5a 100644
--- a/src/gba/memory.c
+++ b/src/gba/memory.c
@@ -473,7 +473,23 @@ uint32_t GBALoadBad(struct ARMCore* cpu) {
 	return value;
 }
 
+
+/* --- harness watchpoints --- */
+uint32_t harness_wlo = 1, harness_whi = 0; int harness_wmode = 0;
+struct HarnessHit { uint32_t pc, addr, val, lr; uint8_t size, write, thumb, pad; };
+struct HarnessHit harness_hits[65536]; uint32_t harness_nhits = 0;
+static inline void harnessWatch(struct ARMCore* cpu, uint32_t a, uint32_t v, int size, int w, int n) {
+	if (!harness_wmode) return;
+	uint32_t e = a + (uint32_t)(4 * (n ? n : 1));
+	if (e <= harness_wlo || a > harness_whi) return;
+	if (!(harness_wmode & (w ? 1 : 2))) return;
+	if (harness_nhits >= 65536) return;
+	struct HarnessHit* h = &harness_hits[harness_nhits++];
+	h->pc = cpu->gprs[ARM_PC] - (cpu->executionMode == MODE_THUMB ? 4 : 8);
+	h->addr = a; h->val = v; h->lr = cpu->gprs[ARM_LR]; h->size = size; h->write = w; h->thumb = cpu->executionMode == MODE_THUMB;
+}
 uint32_t GBALoad32(struct ARMCore* cpu, uint32_t address, int* cycleCounter) {
+	harnessWatch(cpu, address, 0, 4, 0, 0);
 	struct GBA* gba = (struct GBA*) cpu->master;
 	struct GBAMemory* memory = &gba->memory;
 	uint32_t value = 0;
@@ -533,6 +549,7 @@ uint32_t GBALoad32(struct ARMCore* cpu, uint32_t address, int* cycleCounter) {
 }
 
 uint32_t GBALoad16(struct ARMCore* cpu, uint32_t address, int* cycleCounter) {
+	harnessWatch(cpu, address, 0, 2, 0, 0);
 	struct GBA* gba = (struct GBA*) cpu->master;
 	struct GBAMemory* memory = &gba->memory;
 	uint32_t value = 0;
@@ -648,6 +665,7 @@ uint32_t GBALoad16(struct ARMCore* cpu, uint32_t address, int* cycleCounter) {
 }
 
