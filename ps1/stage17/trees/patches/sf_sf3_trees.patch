+  u32 *p = pnew(5);
+  if (p) { p[1] = 0x28000000 | trunkc; p[2] = XY(sx - tw, cy); p[3] = XY(sx + tw, cy); p[4] = XY(sx - tw, sby); p[5] = XY(sx + tw, sby); link_ot(bk, p, 5); }
