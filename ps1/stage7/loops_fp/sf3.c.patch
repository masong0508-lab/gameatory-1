+   sectors do not list loops: the GBA engine draws them from a separate list). */
+#define LOOP_SEG 24
+int sf3_loop_get(int k, s32 *x, s32 *z, int *d) { if (k < 0 || k >= nloop) return 0; *x = loops[k].x; *z = loops[k].z; *d = loops[k].dir & 3; return 1; }   /* test hook (rt.c LOOPTEST) */
+int sf3_nloops(void) { return nloop; }
+static void loop_pt(const Loop *lp, int i, int lat, V3 *o) {
+  static const s8 fx_[4] = { 0, 1, 0, -1 }, fz_[4] = { 1, 0, -1, 0 };
+  int d = lp->dir & 3, ang = i * (65536 / LOOP_SEG), r = lp->r;
+  int along = (r * fsin(ang)) >> 14, up = r - ((r * fcos(ang)) >> 14), side = lat + ((lp->w * (ang >> 2)) >> 14);
+  o->x = lp->x + fx_[d] * along + fz_[d] * side; o->y = up; o->z = lp->z + fz_[d] * along - fx_[d] * side;
+}
+static void draw_loop(int k) {
+  const Loop *lp = &loops[k]; int r = lp->r, w = lp->w;
+  if (dist_rect(lp->x - r - w, lp->z - r - w, lp->x + r + w, lp->z + r + w) > reach) return;
+  if (!in_view(lp->x, r, lp->z, r * 3 / 2 + w + 300)) return;
+  V3 a0, a1, b0, b1; loop_pt(lp, 0, -w / 2, &a0); loop_pt(lp, 0, w / 2, &a1);
+  for (int i = 0; i < LOOP_SEG; i++) {
+    loop_pt(lp, i + 1, -w / 2, &b0); loop_pt(lp, i + 1, w / 2, &b1);
+    int key = zdepth((a0.x + b1.x) >> 1, (a0.y + b1.y) >> 1, (a0.z + b1.z) >> 1);
+#ifdef LOOPDBG
+    dbg("L"); ddec(k); ddec(i); ddec(a0.x); ddec(a0.y); ddec(a0.z); ddec(key); dbg("\n");
+#endif
+    g_src = 8; quad_flat(a0, a1, b0, b1, flat_col(4, 2 - (i & 1), 0), key, 0);
+    a0 = b0; a1 = b1;
+  }
+}
