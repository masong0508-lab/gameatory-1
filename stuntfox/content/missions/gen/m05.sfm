contract kx "BLAST CONTRACT" map=5 giver=dusty par=auto pay=300 score=30 fail=time mode=foot
  crates kx.1..kx.3 drop=kx.drop "CARRY THE CRATES"

contract kt "TRUCK ESCORT" map=5 giver=rook par=auto pay=450 score=40 fail=escort,time mode=drive
