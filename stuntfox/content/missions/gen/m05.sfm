  race gk2.1..gk2.6 "RACE THE LANES"

chal gc1 "PARTS RUN" map=5 par=auto pay=150 score=20 fail=time start=gc1.s mode=foot
  collect gc1.1..gc1.6 "GRAB THE PARTS"

chal gs1 "STUNT SCHOOL" map=5 par=75 pay=200 score=30 fail=time start=gs1.s mode=drive
  stunt points=2000 zone=gs1.z "SHOW SOME TRICKS"

medal gm1 "AERIE" map=5 par=auto pay=200 score=20 start=gm1.s mode=fly
  land gm1.1 "LAND ON THE TOP"

medal gm2 "TOP OF THE WORLD" map=5 par=auto pay=200 score=20 start=gm2.s mode=fly
  land gm2.1 "LAND ON THE TOP"

