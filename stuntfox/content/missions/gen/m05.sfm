contract kc "COURIER RUN" map=5 giver=pip par=auto pay=250 score=20 fail=time,vehlost mode=drive
  deliver kc.1..kc.2 mode=drive "DELIVER THE PARCEL"

contract kb "BOUNTY HUNT" map=5 giver=dusty par=auto pay=350 score=30 fail=time mode=drive
  destroy kb.1..kb.3 type=0 "WRECK THE CARS"

contract kr "RING TIME ATTACK" map=5 giver=nova par=auto pay=300 score=30 fail=time mode=fly
  rings kr.1..kr.11 "FLY THE COURSE"

contract kd "LEG WORK" map=5 giver=quill par=auto pay=200 score=20 fail=time mode=foot
