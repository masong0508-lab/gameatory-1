  rings gr2.1..gr2.9 "FLY THE RINGS"

chal gr3 "THE SQUEEZE" map=7 par=auto pay=250 score=40 fail=time start=gr3.s mode=fly
  rings gr3.1..gr3.9 strict "FLY THE RINGS"

chal gl1 "PIGEON PATROL" map=7 par=auto pay=150 score=20 fail=time start=gl1.s mode=fly
