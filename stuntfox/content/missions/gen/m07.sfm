  land gm2.1 "LAND ON THE TOP"

medal gm3 "AERIE" map=7 par=auto pay=200 score=20 start=gm3.s mode=fly
  land gm3.1 "LAND ON THE TOP"

medal gm4 "LIGHTNING LANE" map=7 par=19 pay=200 score=20 fail=time start=gm4.s mode=drive
  check gm4.1..gm4.4 "BEAT THE CLOCK"

medal gm5 "LONG JUMP" map=7 par=60 pay=200 score=20 fail=time start=gm5.s mode=drive
  jump cells=6 "JUMP THE GAP"

medal gm6 "SHOWSTOPPER" map=7 par=90 pay=200 score=20 fail=time start=gm6.s mode=drive
