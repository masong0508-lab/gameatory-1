  land gl2.2 "ROOF 2 OF 4"
  land gl2.3 "ROOF 3 OF 4"
  land gl2.4 "ROOF 4 OF 4"

chal gk1 "LAP ATTACK" map=7 par=auto pay=200 score=30 fail=time start=gk1.s mode=drive
  race gk1.1..gk1.6 "RACE THE LANES"

chal gk2 "BACK ROAD BLITZ" map=7 par=auto pay=250 score=30 fail=time start=gk2.s mode=drive
  race gk2.1..gk2.3 "RACE THE LANES"

chal gc1 "PARTS RUN" map=7 par=auto pay=150 score=20 fail=time start=gc1.s mode=foot
  collect gc1.1..gc1.6 "GRAB THE PARTS"

chal gb1 "CRATE CRUSHER" map=7 par=60 pay=250 score=30 fail=time start=gb1.s mode=drive
  blast gb1.z n=4 "BREAK THE BOXES"

chal gs1 "STUNT SCHOOL" map=7 par=75 pay=200 score=30 fail=time start=gs1.s mode=drive
  stunt points=2000 zone=gs1.z "SHOW SOME TRICKS"

medal gm1 "CROWN JEWEL" map=7 par=auto pay=200 score=20 start=gm1.s mode=fly
  land gm1.1 "LAND ON THE TOP"

