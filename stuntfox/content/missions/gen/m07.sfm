contract kc "COURIER RUN" map=7 giver=pip par=auto pay=250 score=20 fail=time,vehlost mode=drive
  deliver kc.1..kc.2 mode=drive "DELIVER THE PARCEL"

contract kb "BOUNTY HUNT" map=7 giver=dusty par=auto pay=350 score=30 fail=time mode=drive
  destroy kb.1..kb.3 type=0 "WRECK THE CARS"

contract kr "RING TIME ATTACK" map=7 giver=nova par=auto pay=300 score=30 fail=time mode=fly
  rings kr.1..kr.10 "FLY THE COURSE"

contract kd "LEG WORK" map=7 giver=quill par=auto pay=200 score=20 fail=time mode=foot
  deliver kd.1..kd.3 mode=foot "DELIVER IT"

contract kx "DEMOLITION JOB" map=7 giver=dusty par=75 pay=300 score=30 fail=time mode=drive
  blast kx.z n=4 "BREAK THE BOXES"

contract kt "TRUCK ESCORT" map=7 giver=rook par=auto pay=450 score=40 fail=escort,time mode=drive
  escort kt.s kt.e type=15 "ESCORT THE TRUCK"
