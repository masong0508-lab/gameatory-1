chal gr1 "TAIL CHASE" map=6 par=auto pay=150 score=20 fail=time start=gr1.s mode=fly
  rings gr1.1..gr1.10 "FLY THE RINGS"

chal gr2 "WIND TUNNEL" map=6 par=auto pay=200 score=30 fail=time start=gr2.s mode=fly
  rings gr2.1..gr2.9 "FLY THE RINGS"

chal gr3 "THE SQUEEZE" map=6 par=auto pay=250 score=40 fail=time start=gr3.s mode=fly
  rings gr3.1..gr3.9 strict "FLY THE RINGS"

chal gl1 "ATTIC ATTACK" map=6 par=auto pay=150 score=20 fail=time start=gl1.s mode=fly
  land gl1.1 "ROOF 1 OF 5"
  land gl1.2 "ROOF 2 OF 5"
  land gl1.3 "ROOF 3 OF 5"
  land gl1.4 "ROOF 4 OF 5"
  land gl1.5 "ROOF 5 OF 5"

chal gl2 "CHIMNEY CHASE" map=6 par=auto pay=200 score=20 fail=time start=gl2.s mode=fly
  land gl2.1 "ROOF 1 OF 4"
  land gl2.2 "ROOF 2 OF 4"
  land gl2.3 "ROOF 3 OF 4"
  land gl2.4 "ROOF 4 OF 4"

chal gc1 "JUNK HUNT" map=6 par=auto pay=150 score=20 fail=time start=gc1.s mode=foot
  collect gc1.1..gc1.6 "GRAB THE PARTS"

chal gb1 "DEMOLITION DAY" map=6 par=60 pay=250 score=30 fail=time start=gb1.s mode=drive
  blast gb1.z n=8 "BREAK THE BOXES"

chal gs1 "TRICK SHOT" map=6 par=75 pay=200 score=30 fail=time start=gs1.s mode=drive
  stunt points=2000 zone=gs1.z "SHOW SOME TRICKS"

medal gm5 "LEAP OF FAITH" map=6 par=60 pay=200 score=20 fail=time start=gm5.s mode=drive
  jump cells=6 "JUMP THE GAP"

medal gm6 "TRICK MEDAL" map=6 par=90 pay=200 score=20 fail=time start=gm6.s mode=drive
  stunt points=3000 zone=gm6.z "SHOW SOME TRICKS"

medal gm7 "BULLSEYE" map=6 par=auto pay=200 score=20 start=gm7.s mode=fly
  land gm7.1 "LAND ON THE MARK"

medal gm8 "DEAD CENTRE" map=6 par=auto pay=200 score=20 start=gm8.s mode=fly
  land gm8.1 "LAND ON THE MARK"

medal gm9 "SOFT LANDING" map=6 par=auto pay=200 score=20 start=gm9.s mode=fly
  land gm9.1 "LAND ON THE MARK"

medal gm10 "PERFECT PARK" map=6 par=auto pay=200 score=20 start=gm10.s mode=fly
  land gm10.1 "LAND ON THE MARK"

contract kc "COURIER RUN" map=6 giver=pip par=auto pay=250 score=20 fail=time,vehlost mode=drive
  deliver kc.1..kc.2 mode=drive "DELIVER THE PARCEL"

contract kb "BOUNTY HUNT" map=6 giver=dusty par=auto pay=350 score=30 fail=time mode=drive
  destroy kb.1..kb.3 type=0 "WRECK THE CARS"

contract kr "RING TIME ATTACK" map=6 giver=nova par=auto pay=300 score=30 fail=time mode=fly
  rings kr.1..kr.11 "FLY THE COURSE"

contract kd "LEG WORK" map=6 giver=quill par=auto pay=200 score=20 fail=time mode=foot
  deliver kd.1..kd.3 mode=foot "DELIVER IT"

contract kx "BLAST CONTRACT" map=6 giver=dusty par=auto pay=300 score=30 fail=time mode=foot
  crates kx.1..kx.3 drop=kx.drop "CARRY THE CRATES"

contract kt "TRUCK ESCORT" map=6 giver=rook par=auto pay=450 score=40 fail=escort,time mode=drive
  escort kt.s kt.e type=15 "ESCORT THE TRUCK"
