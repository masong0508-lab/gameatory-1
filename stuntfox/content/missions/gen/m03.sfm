  rings gr2.1..gr2.11 "FLY THE RINGS"

chal gr3 "THE SQUEEZE" map=3 par=auto pay=250 score=40 fail=time start=gr3.s mode=fly
  rings gr3.1..gr3.9 strict "FLY THE RINGS"

chal gl1 "TILE TOUR" map=3 par=auto pay=150 score=20 fail=time start=gl1.s mode=fly
  land gl1.1 "ROOF 1 OF 4"
  land gl1.2 "ROOF 2 OF 4"
  land gl1.3 "ROOF 3 OF 4"
  land gl1.4 "ROOF 4 OF 4"

